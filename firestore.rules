rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'german.lozano45@gmail.com';
    }
    match /coral_trips/{tripId} {
      allow read, delete: if owner();
      allow create, update: if owner()
        && tripId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.keys().hasOnly(['payload','revision','updatedAt','updatedBy'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 800000
        && request.resource.data.revision is int
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ((!exists(/databases/$(database)/documents/coral_trips/$(tripId)) && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/coral_trips/$(tripId)) && request.resource.data.revision == resource.data.revision + 1));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
